# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  The BACKEND/DATABASE/FRONTEND/DOCKER sections below work out of the
#  box with docker compose — no setup needed.
#
#  The SUPERVITY AUTO / SUPABASE / GEMINI sections are NOT optional for
#  this app (unlike the generic starter template): the Procurement
#  Exception Command Center is wired to a real Supervity Auto workflow
#  and a real Supabase project as its system of record. Without valid
#  values there, the containers still start, but disruption notices
#  can't be submitted/processed and the dashboards will show empty
#  data. These are deliberately left blank here (not committed) —
#  request the live credentials from the team rather than guessing.
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev

# ------------------------------------------------------------
# SUPERVITY AUTO (REQUIRED — the Orchestrator/Operators that process
# every disruption notice submitted through this app)
# ------------------------------------------------------------
# API key for your Supervity Auto workspace (auto.supervity.ai)
SUPERVITY_API_KEY=
# The workflow ID for the "Procurement Exception Commander" orchestrator
SUPERVITY_WORKFLOW_ID=
SUPERVITY_API_URL=https://auto-workflow-api.supervity.ai/api/v1/workflow-runs/execute/stream

# ------------------------------------------------------------
# SUPABASE (REQUIRED — system of record: procurement data, workbench
# items, policy config, and audit tables. Supervity Auto's Operators
# read/write this same database directly, outside this backend.)
# ------------------------------------------------------------
SUPABASE_DB_URL=
SUPABASE_URL=

# ------------------------------------------------------------
# GEMINI (Policies / Insights / AI Manager chat — NOT used for Auto
# agents, which run entirely on auto.supervity.ai. Optional: the app
# degrades gracefully to a fallback message if this is unset or the
# key hits Gemini's own quota/billing limits.)
# ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
